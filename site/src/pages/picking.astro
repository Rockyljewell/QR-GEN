---
import Base from "../layouts/Base.astro";
---

<Base title="Find a target product" description="Find an exact product barcode among recent camera observations or decoded results from a still image.">
  <section class="section-sm hero-bg dark">
    <div class="container">
      <span class="tag">Retail product finder</span>
      <h1>Find the barcode you’re looking for</h1>
      <p class="intro">Set one target, then look for an exact match among nearby barcodes. Use the camera or review a still image. Everything is processed on this device.</p>
    </div>
  </section>
  <section class="section-sm">
    <div class="container" id="picking-app">
      <noscript>This product finder needs JavaScript.</noscript>
      <div class="picking-grid">
        <section class="panel">
          <h2>1. Choose your target</h2>
          <form id="target-form">
            <label class="field">Exact barcode value<textarea id="target-code" rows="3" maxlength="4096" required autocomplete="off" spellcheck="false" aria-describedby="target-help"></textarea></label>
            <p id="target-help" class="help">Spaces, line breaks, case and leading zeros are part of the value. Nothing is trimmed or converted to a number.</p>
            <label class="field"><span>Product name <span class="optional">(optional)</span></span><input id="target-name" maxlength="120" autocomplete="off" /></label>
            <div class="actions"><button class="btn btn-dark" type="submit">Set target</button><button id="clear-target" class="btn btn-light" type="button" disabled>Clear target</button></div>
          </form>
          <p id="target-status" class="help" role="status">Set a target barcode to begin.</p>
          <div class="target-summary"><strong id="target-label"></strong><code id="target-value">No target set</code></div>
          <p class="help">This task is temporary. Reloading the page clears it.</p>
        </section>
        <section class="panel">
          <h2>2. Look for a match</h2>
          <label class="field">Source<select id="source-mode"><option value="camera">Live camera</option><option value="image">Still image</option></select></label>
          <div id="camera-source">
            <label class="field">Starting camera<select id="camera-facing"><option value="back">Back camera</option><option value="front">Front camera</option></select></label>
            <p id="camera-gate" class="gate">Set a target in step 1 to turn on the camera.</p>
            <div id="camera-stage" hidden>
              <qrgen-scanner id="scanner" autostart="false" mode="batch" symbologies="all" duplicate-filter="-1" beep="false" vibrate="false"></qrgen-scanner>
              <p class="help">Point the camera at the shelf. Choose a match below, or in the scanner’s list, to highlight it on screen.</p>
            </div>
          </div>
          <div id="image-source" hidden>
            <label class="field">Barcode image<input id="image-file" type="file" accept="image/*" disabled /></label>
            <p id="image-status" class="help" role="status"></p>
            <ul id="image-results" aria-label="Decoded results from the still image"></ul>
          </div>
          <div class="actions"><button id="stop-picking" class="btn btn-light btn-sm" type="button" disabled>Stop</button><button id="reset-picking" class="btn btn-light btn-sm" type="button" disabled>Clear observations</button></div>
          <p id="picking-status" role="status" aria-live="polite"></p>
        </section>
      </div>
      <section class="panel observations" id="camera-observations" aria-label="Recent camera observations">
        <h2>3. Review recent camera observations</h2>
        <p class="help">Barcodes stay listed for half a second after the camera last reads them. This finds products; it does not count stock or record received quantities.</p>
        <div class="picking-grid">
          <div><h3>Target matches</h3><p id="match-status" class="help" role="status">No recent matching observations.</p><ul id="match-list" aria-label="Recent target matches"></ul></div>
          <div><h3>Other barcodes</h3><p id="other-status" class="help" role="status">No recent other observations.</p><ul id="other-list" aria-label="Recent other barcodes"></ul></div>
        </div>
      </section>
    </div>
  </section>
</Base>
<script>import "../scripts/picking";</script>
<style>
  h1 { font-size: clamp(32px, 5vw, 50px); margin: 20px 0 14px; max-width: 22em; }
  .intro { max-width: 48em; font-size: 18px; }
  h2 { margin: 0 0 18px; font-size: 21px; }
  h3 { font-size: 18px; margin: 0 0 12px; }
  .picking-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .panel { border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-soft); min-width: 0; }
  .field { display: flex; flex-direction: column; gap: 7px; margin-bottom: 16px; font-weight: 600; }
  input, select, textarea { width: 100%; border: 1px solid #9ba7b4; border-radius: 8px; padding: 11px 12px; background: var(--white); color: var(--ink); font: inherit; font-weight: 400; min-width: 0; }
  textarea { resize: vertical; }
  input[type="file"] { font-size: 13px; }
  .gate { display: grid; place-items: center; min-height: 200px; padding: 24px; margin: 0; border: 1px dashed #c9d2de; border-radius: var(--radius); background: var(--bg-softer); color: var(--muted); text-align: center; font-size: 14px; }
  .help, .optional { font-size: 13px; color: var(--muted); line-height: 1.6; font-weight: 400; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 16px 0; }
  qrgen-scanner { display: block; height: 360px; border-radius: var(--radius); overflow: hidden; }
  .target-summary { border-top: 1px solid var(--line); padding-top: 16px; display: grid; gap: 8px; }
  #target-value { white-space: pre-wrap; overflow-wrap: anywhere; }
  #target-label { overflow-wrap: anywhere; }
  .observations { margin-top: 24px; }
  #match-list, #other-list, #image-results { list-style: none; padding: 0; display: grid; gap: 12px; }
  #match-list :global(li), #other-list :global(li), #image-results :global(li) { border-bottom: 1px solid var(--line); padding-bottom: 12px; min-width: 0; display: grid; gap: 8px; }
  #match-list :global(code), #other-list :global(code), #image-results :global(code) { white-space: pre-wrap; overflow-wrap: anywhere; }
  #match-list :global(span), #other-list :global(span), #image-results :global(span) { color: var(--muted); font-size: 13px; }
  #match-list :global(button) { justify-self: start; }
  #picking-status { min-height: 1.6em; font-weight: 600; overflow-wrap: anywhere; }
  #picking-status[data-error="true"] { color: #9d2334; }
  button:disabled { opacity: .45; cursor: default; }
  [hidden] { display: none; }
  @media (max-width: 760px) { .picking-grid { grid-template-columns: 1fr; gap: 24px; } .panel { padding: 18px; } }
  @media (max-width: 420px) { .actions { flex-direction: column; align-items: stretch; } }
</style>
