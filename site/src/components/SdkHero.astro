---
// The "SDK & Frameworks" section: headline, framework chips, CTAs and the install terminal.
import { AGENT_PROMPT, SKILLS_INSTALL } from "../lib/prompt";
import { url } from "../lib/site";
import FrameworkChips from "./FrameworkChips.astro";
import Terminal from "./Terminal.astro";

interface Props {
  as?: "h1" | "h2";
  id?: string;
}
const { as: Heading = "h2", id = "sdk" } = Astro.props;
---

<section class="sdk-hero hero-bg dark" id={id} aria-labelledby={`${id}-title`}>
  <div class="container sdk-grid">
    <div class="sdk-copy">
      <span class="tag">SDK &amp; Frameworks</span>
      <Heading id={`${id}-title`} class="sdk-title">Get working code in minutes with QRGen Agent Skills</Heading>
      <p class="sdk-lead">
        QRGen Agent Skills teach your coding agent how to add barcode, QR and ID scanning to your app, with open-source SDKs and pre-built
        components for every platform.
      </p>
      <FrameworkChips />
      <div class="sdk-ctas">
        <a class="btn btn-primary" href={url("/docs/")}>Developer docs</a>
        <a class="btn btn-outline" href={url("/agent-skills/")}>Agent Skills</a>
      </div>
    </div>
    <Terminal
      id={`${id}-terminal`}
      tabs={[
        { label: "Install", text: SKILLS_INSTALL, kind: "shell" },
        { label: "Agent prompt", text: AGENT_PROMPT, kind: "prompt" },
      ]}
    />
  </div>
</section>

<style>
  .sdk-hero {
    padding: 96px 0 104px;
    overflow: hidden;
  }
  .sdk-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .sdk-copy {
    max-width: 660px;
  }
  .sdk-title {
    margin: 36px 0 22px;
    font-size: clamp(36px, 4.4vw, 50px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .sdk-lead {
    font-size: 19px;
    line-height: 1.5;
    color: #e9eef5 !important;
    margin-bottom: 28px;
    max-width: 38em;
  }
  .sdk-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .sdk-ctas .btn {
    min-width: 166px;
  }
  .sdk-hero :global(.terminal .panel) {
    min-height: 410px;
  }
  .sdk-hero :global(.terminal .panel pre.p) {
    max-height: 410px;
    overflow-y: auto;
    padding: 52px 28px 28px;
  }
  @media (max-width: 1000px) {
    .sdk-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .sdk-hero :global(.terminal .panel) {
      min-height: 0;
    }
  }
</style>
