---
import { FOOTER } from "../lib/nav";
import { FOOTER_TARGETS, shareTargets } from "../lib/share";
import { AUTHOR, GITHUB, url } from "../lib/site";
import Icon from "./Icon.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
  /** Canonical URL and title of the current page, for the share links. */
  pageUrl: string;
  pageTitle: string;
}
const { pageUrl, pageTitle } = Astro.props;
const href = (h: string) => (h.startsWith("http") ? h : url(h));
const year = new Date().getFullYear();
const years = year > 2026 ? `2026–${year}` : "2026";
const share = shareTargets(pageUrl, pageTitle).filter((t) => FOOTER_TARGETS.includes(t.id));
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <Wordmark />
        <p>Open-source smart data capture. Barcode, QR and ID scanning for every platform, free under the Apache License 2.0 and private by default.</p>
        <div class="footer-badges">
          <a class="store-badge" href={url("/demo/")}>
            <Icon name="scan" size={22} />
            <span>Try it in your browser<strong>Live demo</strong></span>
          </a>
          <a class="store-badge" href={GITHUB.url} target="_blank" rel="noopener">
            <Icon name="github" size={22} />
            <span>Source code on<strong>GitHub</strong></span>
          </a>
        </div>
      </div>
      {
        FOOTER.map((col) => (
          <div>
            <h4>{col.title}</h4>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={href(l.href)} {...(l.external ? { target: "_blank", rel: "noopener" } : {})}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="footer-share">
      <div class="footer-share-text">
        <strong>Share QRGen</strong>
        <span>Know someone who works with barcodes? Send them this page.</span>
      </div>
      <ul class="footer-share-list">
        {
          share.map((t) => (
            <li>
              <a href={t.href} aria-label={`Share on ${t.label}`} title={t.label} data-share-target={t.id} {...(t.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d={t.path} />
                </svg>
              </a>
            </li>
          ))
        }
        <li>
          <button type="button" data-copy={pageUrl} title="Copy link">
            <Icon name="link" size={18} /><span class="sr-only">Copy link</span>
          </button>
        </li>
        <li>
          <button type="button" class="more" data-share-open>
            <Icon name="share" size={16} /> More
          </button>
        </li>
      </ul>
    </div>
    <div class="footer-bottom">
      <span>
        Created by <a class="footer-credit" href={AUTHOR.url} target="_blank" rel="noopener">{AUTHOR.name}</a> · © {years}
        {" · "}<a href={`${GITHUB.url}/blob/main/LICENSE`} target="_blank" rel="noopener">Apache License 2.0</a> · Not affiliated with any commercial scanning vendor.
      </span>
      <div class="socials">
        <a href={GITHUB.url} aria-label="GitHub" target="_blank" rel="noopener"><Icon name="github" size={18} /></a>
        <a href={GITHUB.discussions} aria-label="Discussions" target="_blank" rel="noopener"><Icon name="users" size={18} /></a>
        <a href={url("/llms.txt")} aria-label="llms.txt"><Icon name="bot" size={18} /></a>
      </div>
    </div>
  </div>
</footer>
