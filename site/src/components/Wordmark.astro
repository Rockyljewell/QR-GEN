---
import { url } from "../lib/site";
interface Props {
  href?: string;
}
const { href = url("/") } = Astro.props;
---

<a class="wordmark" href={href} aria-label="QRGen home">
  <span class="mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" fill="none">
      <path d="M3 10V5a2 2 0 0 1 2-2h5M22 3h5a2 2 0 0 1 2 2v5M29 22v5a2 2 0 0 1-2 2h-5M10 29H5a2 2 0 0 1-2-2v-5" stroke="#5cc9d6" stroke-width="2.4" stroke-linecap="round"></path>
      <rect x="9" y="9" width="5.5" height="5.5" rx="1" fill="#fff"></rect>
      <rect x="17.5" y="9" width="5.5" height="5.5" rx="1" fill="#fff"></rect>
      <rect x="9" y="17.5" width="5.5" height="5.5" rx="1" fill="#fff"></rect>
      <path d="M17.5 17.5h2.4v2.4h-2.4zM20.6 20.6H23V23h-2.4z" fill="#5cc9d6"></path>
    </svg>
  </span>
  <span>QRGEN</span>
</a>
